# Twitch Bot Configuration
# Leave TWITCH_OAUTH_TOKEN empty to run the API/UI without connecting to Twitch.
# For timeout moderator tracking (EventSub channel.ban), the user token needs
# the channel:moderate scope and the bot account must be a mod of TWITCH_CHANNEL.
TWITCH_OAUTH_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=
TWITCH_CHANNEL=omeiaum

# Kick Chat Configuration
KICK_ENABLED=false
KICK_CHANNEL=meiaum
KICK_CHATROOM_ID=

# MongoDB Configuration (separate DB from the main pererecos-stats instance)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=twitch_stats_subathon
MONGODB_TIMEOUT_MS=5000

# API Configuration
API_ROOT_PATH=
HOST=127.0.0.1
PORT=8002

# Subathon timer (America/Sao_Paulo)
SUBATHON_START=2026-09-06T15:00:00-03:00
SUBATHON_PLACEHOLDER_SECONDS=259200
# First live that counts for ingest latch
SUBATHON_MIN_STREAM_START=2026-09-06T15:00:00-03:00

# Public MeiaUm timer feed (vinnytasso) — primary ends_at/state source
TIMER_FEED_ENABLED=true
TIMER_FEED_URL=https://meiaum.vinnytasso.com.br/api/v1/timer
TIMER_POLL_SECONDS=60
TIMER_SNAPSHOT_HEARTBEAT_SECONDS=300
TIMER_STALE_SECONDS=180

# Pixie.gg — optional money webhooks + marathon fallback (secrets in backend/.env only)
PIXIE_ENABLED=
PIXIE_API_TOKEN=
PIXIE_CREATOR_ID=
PIXIE_WEBHOOK_SECRET=
PIXIE_BASE_URL=
PIXIE_POLL_SECONDS=
PIXIE_SNAPSHOT_HEARTBEAT_SECONDS=
PIXIE_TIMER_STALE_SECONDS=
PIXIE_WEBHOOK_TOLERANCE_SECONDS=
SUBATHON_PAUSE_CREDIT_TOLERANCE_SECONDS=

# 7TV Configuration (channel emote set; safe to keep for this community)
SEVENTV_EMOTE_SET_ID=01HR3ABJ800007QJQMTQH1J05C

# CORS Configuration (comma-separated origins; same-origin local UI does not need this)
# Production example: https://tossemideia.cloud
CORS_ORIGINS=http://127.0.0.1:8002,http://localhost:8002

# Security Configuration (set a token so /health detail is not fully public)
HEALTH_CHECK_TOKEN=
MAX_REQUEST_SIZE=1048576
ENABLE_SECURITY_HEADERS=true
LOG_SECURITY_EVENTS=true
